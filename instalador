def _cor(num):
    if os.environ.get("NO_COLOR") or not sys.stdout.isatty():
        return lambda s: s
    return lambda s: "\033[%sm%s\033[0m" % (num, s)


BOLDO = _cor("1")
AZUL = _cor("1;34")
CIANO = _cor("1;36")
VERDE = _cor("1;32")
VERMELHO = _cor("1;31")
AMARELO = _cor("1;33")
MAGENTA = _cor("1;35")
CINZA = _cor("2")

COR_AGENTE = {
    "Destripador": CIANO,
    "Professor": AZUL,
    "Cético": VERMELHO,
    "Convicto": VERDE,
    "Juiz": MAGENTA,
    "Sócrates": AMARELO,
}


def ag(cor_nome, texto):
    return "%s %s" % (BOLDO(COR_AGENTE.get(cor_nome, AZUL)(cor_nome + " ›")), CINZA(texto))


def banner():
    for linha in bloco():
        print(AZUL(linha))
    print(AZUL("    Genial Labs · INSTALADOR"))
    print(CINZA("    v%s · destrincha qualquer coisa · ensina em 6 fases · saída sempre PDF + DOCX + Obsidian + mermaid" % __version__))


class Progresso:
    def __init__(self, agente):
        self.agente = agente

    def __call__(self, msg, i=0, n=0):
        if n:
            passo = max(1, n // 15)
            if i != n and i % passo != 0:
                return
            print(ag(self.agente, "%s %d/%d" % (msg, i, n)))
        else:
            print(ag(self.agente, msg))


def slug_de(texto):
    import re
    t = "".join(c if c.isalnum() else "-" for c in texto.lower())
    return re.sub(r"-+", "-", t).strip("-")[:32] or "alvo"


def dir_saida_padrao(alvo):
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    return os.path.join(os.getcwd(), "saida", slug_de(os.path.basename(os.path.abspath(alvo))) + "-" + ts)


