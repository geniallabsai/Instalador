def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help", "help", "menu"):
        return menu()
    parser = argparse.ArgumentParser(prog="instalador", add_help=False)
    parser.add_argument("cmd", nargs="?")
    parser.add_argument("resto", nargs=argparse.REMAINDER)
    ns = parser.parse_args(argv)
    cmd = ns.cmd or ""
    resto = ns.resto

    if cmd == "destri":
        p = argparse.ArgumentParser(prog="instalador destri")
        p.add_argument("alvo")
        p.add_argument("-o", "--o", default=None, help="pasta de saída")
        p.add_argument("--json", action="store_true", help="imprime o mapa JSON completo")
        return cmd_destri(p.parse_args(resto))
    if cmd == "curso":
        p = argparse.ArgumentParser(prog="instalador curso")
        p.add_argument("alvo", help="arquivo, pasta ou repositório (use '.')")
        p.add_argument("-o", "--o", default=None, help="pasta de saída")
        p.add_argument("--sem-ia", action="store_true", help="força o motor determinístico")
        return cmd_curso(p.parse_args(resto))
    if cmd == "chat":
        p = argparse.ArgumentParser(prog="instalador chat")
        p.add_argument("alvo", nargs="?", default=".")
        p.add_argument("--fase", type=int, default=1)
        p.add_argument("--rodadas", type=int, default=0, help="0 = até você sair")
        p.add_argument("--mapa", default=None, help="usa um mapa.json existente em vez de destrinchar")
        return cmd_chat(p.parse_args(resto))
    if cmd == "debate":
        p = argparse.ArgumentParser(prog="instalador debate")
        p.add_argument("tema", nargs="+")
        p.add_argument("--alvo", default=None, help="caminho de código que alimenta o debate")
        return cmd_debate(p.parse_args(resto))
    if cmd == "status":
        return cmd_status(None)
    if cmd == "arte":
        return cmd_arte(None)
    if cmd == "instale":
        return cmd_instale(None)
    if cmd == "desinstale":
        return cmd_desinstale(None)
    if cmd == "--versao" or cmd == "versao":
        print(__version__)
        return 0
    print(VERMELHO("comando desconhecido: %s" % cmd))
    return menu()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print()
        print(CINZA("interrompido."))
        sys.exit(130)
