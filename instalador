def cmd_instale(_args):
    home = os.path.expanduser("~")
    if os.name == "nt":
        base = os.environ.get("LOCALAPPDATA", os.path.join(home, "AppData", "Local"))
        bin_dir = os.path.join(base, "GenialInstalador", "bin")
        os.makedirs(bin_dir, exist_ok=True)
        py = shutil.which("python") or shutil.which("python3") or "python"
        wrapper = os.path.join(bin_dir, "instalador.cmd")
        with open(wrapper, "w", encoding="ascii", errors="replace") as f:
            f.write("@echo off\r\nset PYTHONUTF8=1\r\n\"%s\" \"%s\" %%*\r\n" % (py, RAIZ.replace("/", "\\")))
        print(VERDE("✓ wrapper criado: " + wrapper))
        print(CINZA("  garanta que %s está no PATH" % bin_dir))
    else:
        bin_dir = os.path.join(home, ".local", "bin")
        os.makedirs(bin_dir, exist_ok=True)
        wrapper = os.path.join(bin_dir, "instalador")
        with open(wrapper, "w", encoding="utf-8") as f:
            f.write("#!/bin/sh\n# Genial Labs · INSTALADOR — wrapper\nexport PYTHONUTF8=1\nexport PYTHONIOENCODING=utf-8\nPY=\"$(command -v python3 || command -v python)\"\n[ -z \"$PY\" ] && { echo 'instalador: python3 nao encontrado' >&2; exit 127; }\nexec \"$PY\" \"%s\" \"$@\"\n" % os.path.abspath(__file__))
        os.chmod(wrapper, 0o755)
        print(VERDE("✓ wrapper criado: " + wrapper))
        if (":" + bin_dir + ":") not in (":" + os.environ.get("PATH", "") + ":"):
            print(CINZA("  adicione ao PATH: export PATH=\"%s:$PATH\" (ou abra um novo terminal)" % bin_dir))
    return 0


def cmd_desinstale(_args):
    removidos = []
    if os.name == "nt":
        base = os.environ.get("LOCALAPPDATA", os.path.join(os.path.expanduser("~"), "AppData", "Local"))
        wrapper = os.path.join(base, "GenialInstalador", "bin", "instalador.cmd")
    else:
        wrapper = os.path.join(os.path.expanduser("~"), ".local", "bin", "instalador")
    if os.path.exists(wrapper):
        os.remove(wrapper)
        removidos.append(wrapper)
    if removidos:
        for r in removidos:
            print("removido: %s" % r)
        print(VERDE("comando global removido. (os arquivos do repositório ficam onde estão)"))
    else:
        print("nada para remover.")
    return 0


