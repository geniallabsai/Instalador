def cmd_destri(args):
    alvo = args.alvo
    mapa = Destripador().destruir(alvo, ao_avisar=Progresso("Destripador"))
    base = args.o or dir_saida_padrao(alvo)
    os.makedirs(base, exist_ok=True)
    with open(os.path.join(base, "mapa.json"), "w", encoding="utf-8") as f:
        json.dump(mapa, f, ensure_ascii=False, indent=1)
    from instalador_core import mermaid
    with open(os.path.join(base, "mapa.mmd"), "w", encoding="utf-8") as f:
        f.write(mermaid.mapa_mermaid(mapa) + "\n")
    if args.json:
        print(json.dumps(mapa, ensure_ascii=False, indent=1))
        return 0
    print()
    print(BOLDO("── DESTRINCHADO ─────────────────────────────────────────────"))
    print("nome: %s" % mapa["nome"])
    print("resumo: %s" % mapa.get("resumo", ""))
    print("escala: %d arquivos · %d linhas · dominante: %s" % (
        mapa["arquivos_total"], mapa["linhas_total"], mapa.get("dominante") or "?"))
    print("linguagens: %s" % ", ".join("%s (%d)" % kv for kv in mapa["linguagens"].items()))
    print(BOLDO("\n── RISCOS COM EVIDÊNCIA (%d) ──" % (len(mapa.get("riscos", [])) + len(mapa.get("estruturais", [])))))
    for r in mapa.get("riscos", [])[:12]:
        cor = VERMELHO if r["nivel"] == "critico" else (AMARELO if r["nivel"] == "alto" else CINZA)
        print("  %s [%-7s] %s:%s" % (cor("●"), r["nivel"], r["arquivo"], r["linha"]))
    for e in mapa.get("estruturais", [])[:6]:
        print("  %s [%-7s] %s — %s" % (AMARELO("○"), e.get("nivel", "?"), e.get("arquivo", ""), e.get("texto", "")))
    print(BOLDO("\n── LEITURA SUGERIDA ──"))
    for i, cam in enumerate(mapa.get("leitura_sugerida", [])[:8], 1):
        print("  %2d. %s" % (i, cam))
    print("\n  escrito: %s" % VERDE(os.path.join(base, "mapa.json")))
    print("  escrito: %s" % VERDE(os.path.join(base, "mapa.mmd")))
    print(CINZA("\n  próximo passo: instalador curso %s" % alvo))
    return 0


def cmd_curso(args):
    banner()
    print()
    alvo = args.alvo
    if args.sem_ia:
        os.environ["INSTALADOR_SEM_IA"] = "1"
        llm._CACHE.clear()

    mapa = Destripador().destruir(alvo, ao_avisar=Progresso("Destripador"))
    print(ag("Cético", "caçando objeções com evidência…"))
    objecoes = Cetico().objetar(mapa)
    print(ag("Convicto", "reunindo defesas…"))
    defesas = Convicto().defender(mapa)
    print(ag("Juiz", "ponderando…"))
    juizo = Juiz().decidir(mapa, objecoes, defesas)
    print(ag("Juiz", "confiança %d/100 · %s" % (juizo["confianca"], CINZA(juizo["barra"]))))

    curso = Professor().ensinar(mapa, juizo, sem_ia=args.sem_ia, ao_avisar=Progresso("Professor"))

    base = args.o or dir_saida_padrao(alvo)
    caminhos = relatorios.escrever_tudo(base, curso, mapa)

    print()
    print(BOLDO("── CURSO GERADO ─────────────────────────────────────────────"))
    print("  pasta: %s" % VERDE(base))
    nomes = [
        ("pdf", "curso.pdf — para humanos abrirem e imprimir"),
        ("docx", "curso.docx — para editar no Word/LibreOffice"),
        ("md", "curso.md — para Codex, Claude Code e Cursor"),
        ("mapa_json", "mapa.json — grafo completo de máquinas"),
        ("obsidian", "obsidian/ — vault pronto (MOC + nota por fase)"),
        ("mmd_mapa", "mapa.mmd — diagrama mermaid do material"),
        ("mmd_curso", "curso.mmd — diagrama mermaid do fluxo do curso"),
    ]
    for chave, desc in nomes:
        caminho = caminhos[chave]
        print("  %s %s" % (VERDE("✓"), desc))
    print()
    print(CINZA("Prompt para outro agente (copie e cole):"))
    print(CINZA('  "Leia curso.md e mapa.json em %s. Explique a fase 3 para um iniciante e me faça 5 perguntas antes de eu avançar."' % base))
    print(CINZA('Vault Obsidian: arraste a pasta "obsidian" para a aplicação e abra 00-moc.'))
    return 0


def cmd_chat(args):
    banner()
    print()
    if args.mapa and os.path.exists(args.mapa):
        with open(args.mapa, encoding="utf-8") as f:
            mapa = json.load(f)
        print(ag("Sócrates", "mapa carregado: %s" % args.mapa))
    else:
        alvo = args.alvo
        mapa = Destripador().destruir(alvo, ao_avisar=Progresso("Destripador"))
    soc = Socrates()
    estado = {"fase": max(1, min(6, args.fase)), "nivel": 3, "seq": 0, "rodada": 0}
    print(ag("Sócrates", "assumo a cadeira. alvo: %s" % mapa.get("nome", "?")))
    print(CINZA("  comandos: /fase N · /nivel N · sair"))
    pergunta = soc.pergunta(mapa, estado)
    print()
    print(AMARELO("Sócrates › ") + pergunta)
    rodadas_limite = args.rodadas if args.rodadas > 0 else 10 ** 9
    while estado["rodada"] < rodadas_limite:
        try:
            linha = input(CINZA("você › "))
        except EOFError:
            print()
            break
        linha = linha.strip()
        if not linha:
            continue
        baixa = linha.lower()
        if baixa in ("sair", "exit", "quit", "tchau"):
            break
        if baixa.startswith("/fase"):
            try:
                estado["fase"] = max(1, min(6, int(baixa.replace("/fase", "").strip())))
                estado["seq"] = 0
                print(CINZA("fase %d." % estado["fase"]))
            except ValueError:
                print(CINZA("uso: /fase N (1–6)"))
            continue
        if baixa.startswith("/nivel"):
            try:
                estado["nivel"] = max(1, min(5, int(baixa.replace("/nivel", "").strip())))
                print(CINZA("nível %d." % estado["nivel"]))
            except ValueError:
                print(CINZA("uso: /nivel N (1–5)"))
            continue
        resposta = soc.responder(mapa, estado, linha)
        print()
        print(AMARELO("Sócrates › ") + resposta.replace("\n", "\n" + AMARELO("           ")))
    print(CINZA("\nfim da conversa. o curso completo espera em: instalador curso %s" % (args.alvo or "ALVO")))
    return 0


def _debate_livre(tema):
    cetico = [
        "'%s' — mas 'sempre' e 'nunca' morrem no primeiro contraexemplo. Qual é o seu?" % tema,
        "e quando a entrada vem vazia, gigante ou em outro idioma?",
        "qual premissa desta afirmação ninguém verificou ainda?",
    ]
    convicto = [
        "o que é observado pode ser verificado de novo — e o que se repete, deixa de ser opinião.",
        "onde há exceção, ela está nomeada: exceção nomeada deixa de ser risco invisível.",
        "o argumento vale no exemplo mínimo; se quebrar na escala, diga onde.",
    ]
    objecoes = [{"nivel": "medio", "evidencia": "tema livre", "texto": c} for c in cetico]
    defesas = [{"texto": c, "evidencia": "tema livre"} for c in convicto]
    return objecoes, defesas


def cmd_debate(args):
    banner()
    print()
    tema = " ".join(args.tema)
    objecoes = defesas = None
    mapa = None
    if args.alvo:
        mapa = Destripador().destruir(args.alvo, ao_avisar=Progresso("Destripador"))
        objecoes, defesas = Cetico().objetar(mapa), Convicto().defender(mapa)
        exibido = "%s (alvo: %s)" % (tema, args.alvo)
    elif os.path.exists(tema):
        mapa = Destripador().destruir(tema, ao_avisar=Progresso("Destripador"))
        objecoes, defesas = Cetico().objetar(mapa), Convicto().defender(mapa)
        exibido = tema
    else:
        obj_llm = llm.chamar(
            "Você é o Cético do Genial Labs: desconfiado, específico, educado. Responda SOMENTE com até 4 linhas iniciadas por '- '. PT-BR.",
            "Objete o seguinte tema: %s" % tema, max_caracteres=700)
        def_llm = llm.chamar(
            "Você é o Convicto do Genial Labs: defende com a versão mais forte da explicação, sempre com evidência. Responda SOMENTE com até 3 linhas iniciadas por '- '. PT-BR.",
            "Defenda o seguinte tema: %s" % tema, max_caracteres=600)
        if obj_llm and def_llm:
            objecoes = [{"nivel": "medio", "evidencia": "modelo", "texto": l.strip().lstrip("-").strip()}
                        for l in obj_llm.splitlines() if l.strip()][:4]
            defesas = [{"texto": l.strip().lstrip("-").strip(), "evidencia": "modelo"}
                       for l in def_llm.splitlines() if l.strip()][:3]
            exibido = tema
        else:
            objecoes, defesas = _debate_livre(tema)
            exibido = tema
    print(BOLDO("DEBATE — %s" % exibido))
    print()
    print(VERMELHO(BOLDO("CÉTICO")))
    for o in objecoes[:6]:
        print("  %s %s" % (VERMELHO("• [%s]" % o.get("nivel", "?").upper()), o.get("texto", "")))
    print()
    print(VERDE(BOLDO("CONVICTO")))
    for d in defesas[:6]:
        print("  %s %s" % (VERDE("•"), d.get("texto", "")))
    print()
    juizo = Juiz().decidir({"riscos": []}, objecoes, defesas)
    print(MAGENTA(BOLDO("JUÍZ")))
    print("  %s %s" % (CINZA(juizo["barra"]), BOLDO("confiança %d/100" % juizo["confianca"])))
    print("  %s" % juizo["decisao"])
    print(CINZA("\n  pontuação aberta: pena %d × ganho %d — regras em AGENTES.md" % (
        juizo["pontuacao"]["pena"], juizo["pontuacao"]["ganho"])))
    return 0


